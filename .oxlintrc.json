      }
    ],
    // eslint:recommended / react errors that Oxlint ships as nursery rules.
    "no-useless-assignment": "error",
    "react/require-render-return": "error",
    // Stands in for sonarjs/deprecation and react/no-deprecated; new hits fail the ratchet.
    "typescript/no-deprecated": "warn"
  },
  "overrides": [
    {
      "files": [
        "**/*.{js,jsx,mjs,ts,tsx,mts,cts}"
      ],
      "rules": {
        "react/display-name": "error",
